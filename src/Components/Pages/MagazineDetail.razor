@page "/magazine/{Id:int}"
@inject FirearmService Svc
@inject AmmoService AmmoSvc
@inject NavigationManager Nav
@using MakeReady.Models
@using MakeReady.Data

<div class="app-header">
    <button class="btn-icon" @onclick="GoBack">
        <i class="bi bi-arrow-left"></i>
    </button>
    <div style="flex:1; min-width:0;">
        <div class="header-title" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
            @(magazine?.DisplayLabel ?? "Magazine")
        </div>
        @if (magazine != null)
        {
            <div class="header-subtitle">@magazine.Capacity rd capacity</div>
        }
    </div>
    @if (magazine != null)
    {
        <button class="btn-icon" @onclick="() => showEditModal = true" title="Edit">
            <i class="bi bi-pencil"></i>
        </button>
    }
</div>

@if (magazine == null)
{
    <div class="empty-state"><i class="bi bi-hourglass-split"></i><p>Loading...</p></div>
}
else
{
    <div class="page-body">

        <!-- Stats strip -->
        <div class="d-flex gap-2 flex-wrap mb-4">
            <span class="stat-badge">
                <i class="bi bi-bullseye"></i>
                <span>Rounds fired</span>
                <span class="stat-val">@magazine.TotalRoundsFired.ToString("N0")</span>
            </span>
            <span class="stat-badge">
                <i class="bi bi-exclamation-triangle"></i>
                <span>Malfunctions</span>
                <span class="stat-val">@magazine.Malfunctions.Count</span>
            </span>
            @if (magazine.TotalRoundsFired > 0 && magazine.Malfunctions.Count > 0)
            {
                <span class="stat-badge">
                    <i class="bi bi-percent"></i>
                    <span>Malfunction rate</span>
                    <span class="stat-val" style="color:@(magazine.MalfunctionRate > 5 ? "var(--mr-red)" : "var(--mr-accent)")">
                        @magazine.MalfunctionRate.ToString("F2")%
                    </span>
                </span>
            }
            <span class="stat-badge">
                <i class="bi bi-tools"></i>
                <span>Mods</span>
                <span class="stat-val">@magazine.Modifications.Count</span>
            </span>
        </div>

        <!-- Tabs -->
        <div class="detail-tabs">
            <button class="detail-tab @(tab == 0 ? "active" : "")" @onclick='() => tab = 0'>Modifications</button>
            <button class="detail-tab @(tab == 1 ? "active" : "")" @onclick='() => tab = 1'>Malfunctions</button>
        </div>

        <!-- Modifications tab -->
        @if (tab == 0)
        {
            <div class="section-label">Modifications & Accessories</div>

            @if (magazine.Modifications.Count == 0)
            {
                <div class="empty-state" style="padding:32px 0;">
                    <i class="bi bi-tools"></i>
                    <p>No modifications added.</p>
                </div>
            }
            else
            {
                @foreach (var mod in magazine.Modifications.OrderByDescending(m => m.AddedAt))
                {
                    <div class="mr-card" style="margin-bottom:8px;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="@(mod.Type == ModificationType.Modification ? "tag tag-mod" : "tag tag-acc")">
                                @(mod.Type == ModificationType.Modification ? "Mod" : "Accessory")
                            </span>
                            <span style="font-weight:600; flex:1;">@mod.Name</span>
                            <button class="btn-icon danger" @onclick="() => RemoveMod(mod.Id)">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(mod.Notes))
                        {
                            <div style="font-size:0.82rem; color:var(--mr-text-muted); margin-top:8px;">@mod.Notes</div>
                        }
                        <div style="font-size:0.72rem; color:var(--mr-text-muted); margin-top:6px;">
                            Added @mod.AddedAt.ToLocalTime().ToString("MMM d, yyyy")
                        </div>
                    </div>
                }
            }

            <!-- Add mod -->
            <div class="mr-card" style="margin-top:16px; border-color:var(--mr-accent); border-style:dashed;">
                <div class="section-label" style="margin-top:0;">Add Item</div>
                <div class="mb-3">
                    <label class="form-label">Type</label>
                    <select class="form-select" @bind="newModType">
                        <option value="@ModificationType.Modification">Modification</option>
                        <option value="@ModificationType.Accessory">Accessory</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="newModName" placeholder="e.g. Extended baseplate, Anti-tilt follower" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Notes <span style="font-weight:400; text-transform:none; font-size:0.7rem;">(optional)</span></label>
                    <input class="form-control" @bind="newModNotes" placeholder="Brand, date installed..." />
                </div>
                <button class="btn-mr-primary" @onclick="AddMod" disabled="@(string.IsNullOrWhiteSpace(newModName))">
                    <i class="bi bi-plus-lg me-2"></i>Add
                </button>
            </div>
        }

        <!-- Malfunctions tab -->
        @if (tab == 1)
        {
            <div class="section-label">Malfunction Log</div>

            @if (magazine.Malfunctions.Count == 0)
            {
                <div class="empty-state" style="padding:32px 0;">
                    <i class="bi bi-shield-check" style="color:var(--mr-green); opacity:0.7;"></i>
                    <p style="color:var(--mr-green);">No malfunctions recorded.</p>
                </div>
            }
            else
            {
                <div class="mr-card" style="padding:8px 16px; margin-bottom:16px;">
                    @foreach (var mf in magazine.Malfunctions.OrderByDescending(m => m.Date))
                    {
                        <div class="session-row">
                            <div style="min-width:36px; display:flex; align-items:center; justify-content:center;">
                                <i class="bi bi-exclamation-triangle-fill" style="color:var(--mr-red); font-size:1.1rem;"></i>
                            </div>
                            <div class="session-meta" style="flex:1;">
                                <div style="font-weight:600; font-size:0.9rem;">@mf.TypeLabel</div>
                                <div class="session-date">@mf.Date.ToLocalTime().ToString("MMM d, yyyy  h:mm tt")</div>
                                @if (mf.Ammo != null)
                                {
                                    <div class="session-note" style="color:var(--mr-accent);">
                                        <i class="bi bi-bullseye me-1"></i>@mf.Ammo.ShortName
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(mf.Notes))
                                {
                                    <div class="session-note">@mf.Notes</div>
                                }
                            </div>
                            <button class="btn-icon danger" @onclick="() => RemoveMalfunction(mf.Id)">
                                <i class="bi bi-trash3" style="font-size:1rem;"></i>
                            </button>
                        </div>
                    }
                </div>

                <!-- Breakdown by type -->
                <div class="section-label">By Type</div>
                <div class="mr-card">
                    @foreach (var group in MalfunctionsByType)
                    {
                        var pct = (double)group.Count() / magazine.Malfunctions.Count * 100;
                        <div style="margin-bottom:12px;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span style="font-size:0.85rem; font-weight:600;">@group.Key</span>
                                <span style="font-size:0.8rem; color:var(--mr-text-muted);">@group.Count() (@pct.ToString("F0")%)</span>
                            </div>
                            <div style="height:6px; background:var(--mr-surface-2); border-radius:4px;">
                                <div style="height:6px; background:var(--mr-red); border-radius:4px; width:@(pct.ToString("F0"))%;"></div>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Log malfunction -->
            <div class="mr-card" style="margin-top:16px; border-color:var(--mr-red); border-style:dashed;">
                <div class="section-label" style="margin-top:0; color:var(--mr-red);">Log Malfunction</div>
                <div class="mb-3">
                    <label class="form-label">Type</label>
                    <select class="form-select" @bind="newMalfType">
                        @foreach (var t in Enum.GetValues<MalfunctionType>())
                        {
                            <option value="@t">@MalfunctionTypeLabel(t)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Ammo Loaded <span style="font-weight:400; text-transform:none; font-size:0.7rem;">(optional)</span></label>
                    <select class="form-select" @bind="newMalfAmmoId">
                        <option value="">— Not specified —</option>
                        @foreach (var a in allAmmos)
                        {
                            <option value="@a.Id">@a.ShortName</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Notes <span style="font-weight:400; text-transform:none; font-size:0.7rem;">(optional)</span></label>
                    <textarea class="form-control" @bind="newMalfNotes" rows="2"
                              placeholder="Round count, conditions, drill..."></textarea>
                </div>
                <button class="btn-mr-danger" style="width:100%; padding:14px;" @onclick="AddMalfunction">
                    <i class="bi bi-exclamation-triangle me-2"></i>Log Malfunction
                </button>
            </div>
        }

    </div>
}

<!-- Edit magazine modal -->
@if (showEditModal && magazine != null)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:500; display:flex; align-items:flex-end;">
        <div style="background:var(--mr-surface); border-radius:16px 16px 0 0; padding:24px 20px; width:100%; border-top:1px solid var(--mr-border);">
            <div style="font-size:1rem; font-weight:700; margin-bottom:16px;">Edit Magazine</div>
            <div class="mb-3">
                <label class="form-label">Label <span style="font-weight:400; text-transform:none; font-size:0.7rem;">(optional)</span></label>
                <input class="form-control" @bind="editLabel" placeholder='e.g. "Extended", "Backup #1"' />
            </div>
            <div class="mb-4">
                <label class="form-label">Capacity (rounds)</label>
                <input type="number" class="form-control" @bind="editCapacity" min="1" max="200" />
            </div>
            <div class="d-flex flex-column gap-3">
                <button class="btn-mr-primary" @onclick="SaveEdit">Save</button>
                <button class="btn-mr-secondary" @onclick="() => showEditModal = false">Cancel</button>
                <button class="btn-mr-danger" style="width:100%; padding:14px;" @onclick="DeleteMagazine">
                    <i class="bi bi-trash3 me-2"></i>Delete Magazine
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    Magazine? magazine;
    int tab = 0;

    IEnumerable<IGrouping<string, MagazineMalfunction>> MalfunctionsByType =>
        magazine?.Malfunctions.GroupBy(m => m.TypeLabel).OrderByDescending(g => g.Count())
        ?? Enumerable.Empty<IGrouping<string, MagazineMalfunction>>();

    string newModName = "";
    string newModNotes = "";
    ModificationType newModType = ModificationType.Modification;

    MalfunctionType newMalfType = MalfunctionType.FailureToFeed;
    string newMalfNotes  = "";
    string newMalfAmmoId = "";

    List<Ammo> allAmmos = new();

    bool showEditModal = false;
    string editLabel = "";
    int editCapacity = 0;

    int? returnFirearmId;

    protected override async Task OnInitializedAsync()
    {
        allAmmos = await AmmoSvc.GetAllAsync();
        await Reload();
    }

    async Task Reload()
    {
        magazine = await Svc.GetMagazineAsync(Id);
        if (magazine != null)
        {
            returnFirearmId = magazine.FirearmId;
            if (!showEditModal)
            {
                editLabel = magazine.Label;
                editCapacity = magazine.Capacity;
            }
        }
        StateHasChanged();
    }

    async Task AddMod()
    {
        if (string.IsNullOrWhiteSpace(newModName)) return;
        await Svc.AddMagazineModificationAsync(new MagazineModification
        {
            MagazineId = Id,
            Name = newModName.Trim(),
            Type = newModType,
            Notes = string.IsNullOrWhiteSpace(newModNotes) ? null : newModNotes.Trim()
        });
        newModName = "";
        newModNotes = "";
        await Reload();
    }

    async Task RemoveMod(int modId)
    {
        await Svc.DeleteMagazineModificationAsync(modId);
        await Reload();
    }

    async Task AddMalfunction()
    {
        await Svc.AddMalfunctionAsync(new MagazineMalfunction
        {
            MagazineId = Id,
            Type       = newMalfType,
            AmmoId     = int.TryParse(newMalfAmmoId, out var aid) ? aid : null,
            Notes      = string.IsNullOrWhiteSpace(newMalfNotes) ? null : newMalfNotes.Trim()
        });
        newMalfNotes  = "";
        newMalfAmmoId = "";
        await Reload();
    }

    async Task RemoveMalfunction(int mfId)
    {
        await Svc.DeleteMalfunctionAsync(mfId);
        await Reload();
    }

    async Task SaveEdit()
    {
        if (magazine == null || editCapacity < 1) return;
        magazine.Label = editLabel.Trim();
        magazine.Capacity = editCapacity;
        await Svc.SaveMagazineAsync(magazine);
        showEditModal = false;
        await Reload();
    }

    async Task DeleteMagazine()
    {
        await Svc.DeleteMagazineAsync(Id);
        GoBack();
    }

    void GoBack()
    {
        if (returnFirearmId.HasValue)
            Nav.NavigateTo($"/firearm/{returnFirearmId}");
        else
            Nav.NavigateTo("/");
    }

    static string MalfunctionTypeLabel(MalfunctionType t) => t switch
    {
        MalfunctionType.FailureToFeed  => "Failure to Feed",
        MalfunctionType.FailureToEject => "Failure to Eject",
        MalfunctionType.DoubleFeed     => "Double Feed",
        MalfunctionType.Stovepipe      => "Stovepipe",
        MalfunctionType.FailureToFire  => "Failure to Fire",
        MalfunctionType.FailureToLock  => "Failure to Lock",
        _                              => "Other"
    };
}
