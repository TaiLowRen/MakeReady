@page "/dryfire"
@inject DrillService Svc
@inject NavigationManager Nav
@inject NavDrawerState Drawer
@using MakeReady.Models

<div class="app-header">
    <button class="btn-icon" @onclick="Drawer.Toggle" title="Menu">
        <i class="bi bi-list"></i>
    </button>
    <div>
        <div class="header-title">Dry Fire</div>
        <div class="header-subtitle">Drills &amp; practice reps</div>
    </div>
    <button class="btn-icon" @onclick='() => Nav.NavigateTo("/dryfire/new")' title="New drill">
        <i class="bi bi-plus-lg"></i>
    </button>
</div>

<div class="page-body">
    @if (loading)
    {
        <div class="empty-state"><i class="bi bi-hourglass-split"></i><p>Loading...</p></div>
    }
    else if (drills.Count == 0)
    {
        <div class="empty-state" style="margin-top:48px;">
            <i class="bi bi-stopwatch"></i>
            <p style="font-size:1rem; font-weight:600; color:var(--mr-text); margin-bottom:8px;">No drills yet</p>
            <p>Build a drill to run par-time and moving-target reps at home.</p>
            <button class="btn-mr-primary" style="max-width:240px; margin-top:20px;"
                    @onclick='() => Nav.NavigateTo("/dryfire/new")'>
                <i class="bi bi-plus-lg me-2"></i>New Drill
            </button>
        </div>
    }
    else
    {
        <div class="section-label">Your Drills</div>
        @foreach (var d in drills)
        {
            <div class="mr-card">
                <div class="d-flex align-items-start gap-2">
                    <div class="mr-card-pressable" style="flex:1; min-width:0;" @onclick='() => Nav.NavigateTo($"/dryfire/{d.Id}/edit")'>
                        <div style="font-weight:700; font-size:0.95rem;">@d.Name</div>
                        @if (!string.IsNullOrWhiteSpace(d.Notes))
                        {
                            <div style="font-size:0.78rem; color:var(--mr-text-muted); margin-top:1px;">@d.Notes</div>
                        }
                        <div class="d-flex gap-2 flex-wrap mt-2">
                            <span class="stat-badge">
                                <i class="bi bi-bullseye"></i>
                                <span>Targets</span>
                                <span class="stat-val">@d.Targets.Count</span>
                            </span>
                            @if (d.ParTimeSeconds is double par)
                            {
                                <span class="stat-badge">
                                    <i class="bi bi-hourglass-split"></i>
                                    <span>Par</span>
                                    <span class="stat-val">@par.ToString("0.0")s</span>
                                </span>
                            }
                            @if (d.Sessions.Count > 0)
                            {
                                <span class="stat-badge">
                                    <i class="bi bi-journals"></i>
                                    <span>Reps</span>
                                    <span class="stat-val">@d.Sessions.Count</span>
                                </span>
                            }
                        </div>
                    </div>
                    <button class="btn-icon" style="color:var(--mr-accent); font-size:1.6rem;"
                            @onclick='() => Nav.NavigateTo($"/dryfire/{d.Id}/run")' title="Run drill">
                        <i class="bi bi-play-circle-fill"></i>
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    List<Drill> drills = new();
    bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        drills = await Svc.GetDrillsAsync();
        loading = false;
    }
}
