@namespace MakeReady.Components.Layout
@implements IDisposable
@inject NavDrawerState Drawer
@using MakeReady.Services

<div class="nav-drawer-backdrop @(Drawer.IsOpen ? "open" : "")" @onclick="Drawer.Close"></div>

<nav class="nav-drawer @(Drawer.IsOpen ? "open" : "")">
    <div class="nav-drawer-header">
        <div class="header-title">MakeReady</div>
        <button class="btn-icon" @onclick="Drawer.Close" title="Close menu">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <NavLink class="nav-drawer-item" href="" Match="NavLinkMatch.All" ActiveClass="active" @onclick="Drawer.Close">
        <i class="bi bi-collection-fill"></i>
        <span>Firearms</span>
    </NavLink>
    <NavLink class="nav-drawer-item" href="track" ActiveClass="active" @onclick="Drawer.Close">
        <i class="bi bi-crosshair2"></i>
        <span>Track</span>
    </NavLink>
    <NavLink class="nav-drawer-item" href="dryfire" ActiveClass="active" @onclick="Drawer.Close">
        <i class="bi bi-stopwatch"></i>
        <span>Dry Fire</span>
    </NavLink>
    <NavLink class="nav-drawer-item" href="hitfactor" ActiveClass="active" @onclick="Drawer.Close">
        <i class="bi bi-trophy-fill"></i>
        <span>Hit Factor</span>
    </NavLink>
    <NavLink class="nav-drawer-item" href="history" ActiveClass="active" @onclick="Drawer.Close">
        <i class="bi bi-clock-history"></i>
        <span>History</span>
    </NavLink>
    <NavLink class="nav-drawer-item" href="maintenance" ActiveClass="active" @onclick="Drawer.Close">
        <i class="bi bi-tools"></i>
        <span>Maintain</span>
    </NavLink>
    <NavLink class="nav-drawer-item" href="ammo" ActiveClass="active" @onclick="Drawer.Close">
        <i class="bi bi-bullseye"></i>
        <span>Ammo</span>
    </NavLink>
</nav>

@code {
    protected override void OnInitialized() => Drawer.Changed += StateHasChanged;
    public void Dispose() => Drawer.Changed -= StateHasChanged;
}
